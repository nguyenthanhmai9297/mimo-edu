{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "emulators": "node scripts/startEmulators.mjs",
    "emulator:save": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/emulatorData.ts save",
    "emulator:load": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/emulatorData.ts load",
    "dev:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 VITE_USE_FIREBASE_EMULATOR=true tsx server.ts",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx scripts/seedEmulator.ts",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-lop-chung-minh 'vitest run --config vitest.emulator.config.ts'",
    "demo": "firebase emulators:exec --only firestore,auth --project demo-lop-chung-minh 'npm run seed:emulator -- --with-n01 && npm run dev:emulator'",
    "deploy:firebase": "VITE_API_BASE_URL=https://mimo-edu.vercel.app VITE_MEDIA_STORE=cloudinary vite build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "12.12.0",
    "docx": "9.14.0",
    "docx-preview": "0.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "firebase-admin": "14.5.0",
    "html-to-image": "1.11.13",
    "katex": "^0.19.0",
    "lucide-react": "^0.546.0",
    "mathlive": "0.111.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "firebase-tools": "15.33.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "jwks-rsa": "3.2.2"
  }
}
