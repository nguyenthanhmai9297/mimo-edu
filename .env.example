# ANTHROPIC_API_KEY: Required for Claude (default AI provider) - turning PDF/image exams into questions and essay grading suggestions.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# AI_PROVIDER: "anthropic" (default) or "gemini". AI_MODEL: Claude model id, default claude-sonnet-5-5.
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-5-5"

# GEMINI_API_KEY: Only needed when AI_PROVIDER="gemini". Required for server-side Gemini AI API calls (OCR PDF/Image, Math problem solver, Essay grading suggestion).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STUDENT_SESSION_SECRET: Secret key used on the server to sign and verify 6-character student portal tokens.
STUDENT_SESSION_SECRET="lop-chung-toi-demo-hmac-secret-key"

# DEFAULT_ADMIN_EMAIL: Initial bootstrapped admin email for teacher access.
DEFAULT_ADMIN_EMAIL="nguyenthanhmai9297@gmail.com"

# Homework images on Cloudinary (Free plan). Server only: never prefix these with VITE_.
# Leave empty to keep images inside the homework as before.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Front-end switch (build time): set to "cloudinary" only after the three values above work on the API.
VITE_MEDIA_STORE=
