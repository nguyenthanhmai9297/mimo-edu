{
  "entities": {
    "AdminAllowlist": {
      "title": "AdminAllowlist",
      "description": "Authorized teacher and administrator email allowlist record.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Authorized Google account email address.",
          "minLength": 3,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Administrative role."
        },
        "addedBy": {
          "type": "string",
          "description": "Email or UID of the admin who added this entry.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        }
      },
      "required": ["email", "role", "addedBy", "createdAt"]
    },
    "ClassRoom": {
      "title": "ClassRoom",
      "description": "Math classroom metadata.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Class name, e.g., Toán 5A.",
          "minLength": 1,
          "maxLength": 100
        },
        "grade": {
          "type": "string",
          "description": "Grade level, e.g., Khối 5.",
          "minLength": 1,
          "maxLength": 30
        },
        "schoolYear": {
          "type": "string",
          "description": "Academic year, e.g., 2026-2027.",
          "minLength": 4,
          "maxLength": 30
        },
        "description": {
          "type": "string",
          "description": "Class description.",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "Classroom status."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp."
        }
      },
      "required": ["name", "grade", "schoolYear", "status", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student profile and internal teacher notes.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Student full name.",
          "minLength": 1,
          "maxLength": 120
        },
        "nickname": {
          "type": "string",
          "description": "Optional friendly nickname.",
          "maxLength": 60
        },
        "avatarUrl": {
          "type": "string",
          "description": "Avatar identifier or URL.",
          "maxLength": 500
        },
        "grade": {
          "type": "string",
          "description": "Student grade level.",
          "minLength": 1,
          "maxLength": 30
        },
        "classIds": {
          "type": "array",
          "description": "Enrolled class IDs (bounded <= 20)."
        },
        "dob": {
          "type": "string",
          "description": "Date of birth.",
          "maxLength": 40
        },
        "internalNotes": {
          "type": "string",
          "description": "Teacher-only internal notes.",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["active", "dropped", "archived"],
          "description": "Student enrollment status."
        },
        "accessCode": {
          "type": "string",
          "description": "Unique 6-character access code generated by server.",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp."
        }
      },
      "required": ["fullName", "grade", "classIds", "status", "accessCode", "createdAt", "updatedAt"]
    },
    "StudentCodeIndex": {
      "title": "StudentCodeIndex",
      "description": "Server-managed permanent index mapping a 6-character code to a studentId.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$"
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["code", "studentId", "status", "createdAt"]
    },
    "Homework": {
      "title": "Homework",
      "description": "Master homework template authored by teacher or parsed via AI.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "grade": {
          "type": "string",
          "maxLength": 40
        },
        "questions": {
          "type": "array",
          "description": "Structured math questions (max 100)."
        },
        "attachments": {
          "type": "array",
          "description": "Optional attachment metadata."
        },
        "answerSource": {
          "type": "string",
          "enum": ["teacher", "ai"]
        },
        "aiSolverEnabled": {
          "type": "boolean"
        },
        "totalPoints": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "archived"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["title", "subject", "questions", "answerSource", "aiSolverEnabled", "totalPoints", "status", "createdAt", "updatedAt"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Assigned homework instance containing an immutable snapshot of student-safe questions.",
      "type": "object",
      "properties": {
        "homeworkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "instructions": {
          "type": "string",
          "maxLength": 2000
        },
        "targetType": {
          "type": "string",
          "enum": ["class", "students"]
        },
        "classIds": {
          "type": "array"
        },
        "studentIds": {
          "type": "array"
        },
        "assignedAt": {
          "type": "string",
          "maxLength": 50
        },
        "dueAt": {
          "type": "string",
          "maxLength": 50
        },
        "publicQuestionsSnapshot": {
          "type": "array",
          "description": "Questions snapshot stripped of standard answers."
        },
        "gradingKeySnapshot": {
          "type": "array",
          "description": "Full question snapshot with standard answers for grading."
        },
        "publishSolutions": {
          "type": "boolean"
        },
        "maxScore": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["active", "revoked", "closed"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["homeworkId", "title", "targetType", "assignedAt", "dueAt", "publicQuestionsSnapshot", "maxScore", "status", "createdAt", "updatedAt"]
    },
    "StudentAssignment": {
      "title": "StudentAssignment",
      "description": "Individual student progress and status for an assignment.",
      "type": "object",
      "properties": {
        "assignmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["assigned", "in_progress", "submitted", "graded", "returned"]
        },
        "score": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "isScorePublished": {
          "type": "boolean"
        },
        "submittedAt": {
          "type": "string",
          "maxLength": 50
        },
        "gradedAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["assignmentId", "studentId", "status", "maxScore", "isScorePublished", "updatedAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student homework answers, question-level scores, and teacher/AI grading feedback.",
      "type": "object",
      "properties": {
        "assignmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "answers": {
          "type": "array",
          "description": "Student answers per question."
        },
        "questionResults": {
          "type": "array",
          "description": "Graded score and feedback per question."
        },
        "totalScore": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["in_progress", "submitted", "graded", "returned"]
        },
        "teacherOverallComment": {
          "type": "string",
          "maxLength": 2000
        },
        "isPublished": {
          "type": "boolean"
        },
        "submittedAt": {
          "type": "string",
          "maxLength": 50
        },
        "gradedAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["assignmentId", "studentId", "answers", "maxScore", "status", "isPublished", "updatedAt"]
    },
    "CommentReport": {
      "title": "CommentReport",
      "description": "Monthly evaluation or submission-specific feedback for a student.",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": ["monthly", "submission"]
        },
        "month": {
          "type": "number"
        },
        "year": {
          "type": "number"
        },
        "strengths": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "improvements": {
          "type": "string",
          "maxLength": 2000
        },
        "completionRate": {
          "type": "string",
          "maxLength": 200
        },
        "practiceSuggestions": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published"]
        },
        "publishedAt": {
          "type": "string",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["studentId", "type", "strengths", "status", "createdAt", "updatedAt"]
    },
    "MathGame": {
      "title": "MathGame",
      "description": "Educational math game embedded via HTTPS iframe.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "embedUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500,
          "pattern": "^https://.*"
        },
        "category": {
          "type": "string",
          "enum": ["Số học", "Phép tính", "Hình học", "Tư duy logic", "Ôn tập kiến thức"]
        },
        "thumbnailUrl": {
          "type": "string",
          "maxLength": 500
        },
        "order": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "archived"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["title", "embedUrl", "category", "order", "status", "createdAt", "updatedAt"]
    },
    "AIJob": {
      "title": "AIJob",
      "description": "Audit log of server-side AI tasks (OCR, problem solving, essay grading).",
      "type": "object",
      "properties": {
        "taskType": {
          "type": "string",
          "enum": ["ocr_parse", "solve_math", "essay_grade"]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["processing", "completed", "failed"]
        },
        "durationMs": {
          "type": "number"
        },
        "estimatedCostUsd": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50
        }
      },
      "required": ["taskType", "provider", "model", "status", "createdAt"]
    }
  },
  "firestore": {
    "/adminAllowlist/{emailId}": {
      "schema": { "$ref": "#/entities/AdminAllowlist" },
      "description": "Allowlist of authorized admin/teacher Google emails."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassRoom" },
      "description": "Math classes managed by the teacher."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student records and internal notes."
    },
    "/studentCodeIndex/{code}": {
      "schema": { "$ref": "#/entities/StudentCodeIndex" },
      "description": "Permanent 6-character code mapping to studentId."
    },
    "/homework/{homeworkId}": {
      "schema": { "$ref": "#/entities/Homework" },
      "description": "Master homework templates and questions."
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Homework assignments and question snapshots."
    },
    "/studentAssignments/{studentAssignmentId}": {
      "schema": { "$ref": "#/entities/StudentAssignment" },
      "description": "Per-student assignment tracking."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Student homework submissions and grading results."
    },
    "/comments/{commentId}": {
      "schema": { "$ref": "#/entities/CommentReport" },
      "description": "Monthly and per-submission teacher evaluations."
    },
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/MathGame" },
      "description": "Educational math games embedded via HTTPS iframe."
    },
    "/aiJobs/{jobId}": {
      "schema": { "$ref": "#/entities/AIJob" },
      "description": "AI processing job logs."
    }
  }
}
